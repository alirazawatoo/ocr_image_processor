# Bundler and installed dependencies
/.bundle
/vendor/bundle
node_modules/
project_venv/

# Environment files (keep the template)
.env
.env.*
!.env.example

# Rails secrets: the encrypted credentials file has no matching key in
# this repo, and configuration is read from ENV instead
/config/master.key
/config/credentials.yml.enc
/config/credentials/*.key

# Logs, temp files and uploaded blobs
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/storage/*
!/storage/.keep

# Build output and caches
/public/assets
/coverage/
.byebug_history
.rspec_status

# Local Redis dump
dump.rdb

# Images generated by the bounding-box service when run from the app root
/new_image_with_boxes.png
/temp_image_with_boxes.png

# Editor and OS clutter
.DS_Store
.idea/
.vscode/
.github/
