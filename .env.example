# Copy to .env and fill in. docker compose reads this file automatically.

# Password for the bundled Postgres container. Letters and digits only,
# because it is placed inside DATABASE_URL.
POSTGRES_PASSWORD=change-me

# Rails signing key for cookies and document links. Generate one with:
#   openssl rand -hex 64
SECRET_KEY_BASE=

# The Compose demo serves plain HTTP on localhost. Leave FORCE_SSL unset
# (it defaults to true) when the app runs behind HTTPS.
FORCE_SSL=false

# Host port for the web container.
APP_PORT=3000
