<div data-controller="ocr-documents" data-ocr-documents-url-value="<%= search_ocr_document_path(@ocr_document) %>">
<h2 class="image-heading"> hOCR Processed Images</h2>

<% if @ocr_document.failed? %>
  <p class="processing-error" role="alert"><%= @ocr_document.processing_error %></p>
<% end %>

<% if @ocr_document.text_ready? %>
  <div class="search-container">
    <h4>Search the document : </h4>
    <form action="#" data-action="submit->ocr-documents#search">
      <input type="search" placeholder="Search the document" maxlength="100" data-ocr-documents-target="query">
      <button type="submit">Search</button>
    </form>
    <p data-ocr-documents-target="status" aria-live="polite"></p>
  </div>
<% end %>

<div class="image-container">
    <div class="image-wrapper">
        <h4>Original Image (<%= link_to 'Download', rails_blob_path(@ocr_document.original_image, disposition: 'attachment') %> )</h4>
        <div class="image-stack">
          <%= image_tag @ocr_document.original_image, class: "responsive-image", alt: "Uploaded image", data: { ocr_documents_target: "image" } %>
          <canvas class="match-layer" aria-hidden="true" data-ocr-documents-target="canvas"></canvas>
        </div>
    </div>

    <div class="image-wrapper">
        <% if @ocr_document.generated_image.attached? %>
            <h4>Marked Image (<%= link_to 'Download', rails_blob_path(@ocr_document.generated_image, disposition: 'attachment') %> )</h4>
            <%= image_tag @ocr_document.generated_image, class: "responsive-image" %>
        <% elsif @ocr_document.failed? %>
            <h4>Marked Image (not available)</h4>
        <% else %>
            <h4>Marked Image (Being processed, please refresh in a moment!!)</h4>
            <div class="loading-container">
                <%= image_tag "Infinity-1s-200px.gif", class: "loading-image" %>
            </div>
        <% end %>
    </div>
</div>
</div>
